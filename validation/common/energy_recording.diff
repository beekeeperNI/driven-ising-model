 # ==========================================
 
 @njit
+def energy_per_spin(lattice, h=0.0, J=1.0):
+    """只读取构型；周期边界下每条键计算一次，不调用随机数。"""
+    L = lattice.shape[0]
+    E = 0.0
+    for i in range(L):
+        for j in range(L):
+            s = lattice[i, j]
+            E -= J * s * (
+                lattice[(i + 1) % L, j]
+                + lattice[i, (j + 1) % L]
+            )
+            E -= h * s
+    return E / (L * L)
+
+
